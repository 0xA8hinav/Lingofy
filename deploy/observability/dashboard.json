{
  "title": "Lingofy MVP — 1 SLO + cost",
  "tags": ["lingofy", "mvp"],
  "panels": [
    {
      "title": "Chunks: done vs total (backlog = total - done)",
      "targets": [
        { "expr": "lingofy_chunks_done_total" },
        { "expr": "lingofy_chunks_total_total" }
      ]
    },
    {
      "title": "Active sessions",
      "targets": [{ "expr": "lingofy_sessions_total" }]
    },
    {
      "title": "Sarvam TTS usage + est. spend",
      "targets": [
        { "expr": "lingofy_sarvam_calls_total" },
        { "expr": "lingofy_sarvam_inr_est_total" }
      ]
    },
    {
      "title": "Cost guard: Sarvam est. spend vs ₹50 cap",
      "targets": [{ "expr": "lingofy_sarvam_inr_est_total > 50" }]
    }
  ]
}
